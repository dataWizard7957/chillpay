CHILLPAY_DATABASE_URL=sqlite:///./data/chill_pay.sqlite3
CHILLPAY_OLLAMA_URL=http://127.0.0.1:11434
CHILLPAY_OLLAMA_MODEL=gemma:2b
CHILLPAY_OLLAMA_KEEP_ALIVE=30m
CHILLPAY_OLLAMA_READ_TIMEOUT_SECONDS=90
CHILLPAY_VOICE=false
CHILLPAY_TRACING=false
CHILLPAY_EMAIL=false
CHILLPAY_SESSION_IDLE_MINUTES=30
CHILLPAY_SESSION_ABSOLUTE_HOURS=8
CHILLPAY_SESSION_SECURE=false
# Invoice PDFs. Leave unset to use data/invoices under the project.
# CHILLPAY_INVOICE_DIR=
# Backup folder. Leave unset to use backups/ under the project.
# CHILLPAY_BACKUP_DIR=
# Fernet key for PAN and Aadhaar at rest. Generate one; do not commit it:
# py -3.12 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CHILLPAY_ENCRYPTION_KEY=
# Separate secret used only for identifier lookup hashes.
# CHILLPAY_LOOKUP_KEY=
